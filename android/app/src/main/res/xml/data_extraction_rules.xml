<?xml version="1.0" encoding="utf-8"?>
<!--
     BAK-9: Android's own device backup and transfer (API 31+). See
     backup_rules.xml (the API ≤ 30 equivalent Android still reads on older
     devices) for why photos/ and backups/ are excluded from cloud-backup.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="photos" />
        <exclude domain="file" path="backups" />
    </cloud-backup>
    <!-- A phone-to-phone transfer during setup has no size limit (BAK-9),
         so it copies everything, photos included: no rules to narrow it. -->
    <device-transfer />
</data-extraction-rules>
